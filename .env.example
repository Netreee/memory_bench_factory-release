# memory_bench_factory —— 环境变量模板
# 用法:cp .env.example .env,然后把下面的占位符换成你自己的值。
# ★ .env 已被 .gitignore 排除,真 key 绝不要提交。所有 LLM 调用都从 config.py 读这几个变量。

# OpenAI 兼容 API 的 key(占位符,换成你自己的)
OPENAI_API_KEY=sk-your-key-here

# OpenAI 兼容服务的 base_url(用官方就填 https://api.openai.com/v1;用代理/国内中转就填对应地址)
OPENAI_BASE_URL=https://api.openai.com/v1

# 出题用的模型名(随 base_url 而定;可用任意 OpenAI 兼容的 chat 模型,推理模型也行)
MODEL=your-model-name
STRUCTURE_MODEL=your-non-reasoning-json-model

# 可选：盲判别器只做短 JSON 抽取，建议固定非推理模型；不设则沿用 MODEL
# DISCRIMINATOR_MODEL=your-non-reasoning-model-name

# 同时在飞的 LLM 并发上限(打 API 的真实并发 ≤ 此值;按你的额度/限流调,默认 8)
LLM_CONCURRENCY=8

# 可选：普通生成调用显式指定推理强度；仅限 llm_transport.RUN_MODEL_CAPABILITIES 支持的模型/值。
# 不设置时沿用接口默认；保留原 token/超时参数，逐调用显式 transport 优先。
# LLM_REASONING_EFFORT=low

# ─── Ingest LLM(可选,真系统 ingest 的 LLM 快端点)───
# 真系统 ingest 需要大量 LLM 调用(mem0 事实抽取/amem 笔记演化/zep 实体抽取),
# 若 DMXAPI 太慢,可用更快的端点(如 mx-vllm SSH 隧道)。不设则回落 OPENAI_BASE_URL。
# INGEST_LLM_BASE_URL=http://localhost:8000/v1
# INGEST_LLM_MODEL=your-vllm-model

# ─── 外部记忆系统(仅跑 --systems mem0,zep,memos,amem 时需要)───
# 前置:先启动本地 embed_server (embedding 微服务,zep 依赖):
#   ./venv/bin/python -m services.embed_server --port 9800
# 再启动 Docker: docker compose -f docker-compose.eval.yml up -d
# A-Mem: 纯 Python,不需要 Docker;embedding 本地 bge-small-zh-v1.5

# Zep:优先自托管 CE(零额外费用);设了 ZEP_API_KEY 则走 Zep Cloud(需付费)
# ZEP_API_KEY=z_your-zep-cloud-key
# ZEP_BASE_URL=http://localhost:8998          # CE 模式默认,无需改

# MemOS:优先自托管(base_url);设了 MEMOS_API_KEY 则走 MemTensor Cloud
# MEMOS_API_KEY=your-memos-api-key
# MEMOS_BASE_URL=http://localhost:5230/api/openmem/v1   # 自托管默认
