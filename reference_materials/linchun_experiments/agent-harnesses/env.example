# 四个 harness 共用的上游配置。复制为同目录 .env 后只填 OPENAI_API_KEY。
# 加载：source scripts/env.sh（会自动读本目录 .env）

# ── 必填：自行填入 ──
OPENAI_API_KEY=

# ── 国内 OpenAI 兼容代理 ──
# 主端点：https://llm-proxy.humanlaya.com/v1/chat/completions
# SDK/CLI 一般要带 /v1 的 base，由客户端再拼 /chat/completions
OPENAI_BASE_URL=https://llm-proxy.humanlaya.com/v1
OPENAI_CHAT_COMPLETIONS_URL=https://llm-proxy.humanlaya.com/v1/chat/completions

# 可用模型（仅下列名字）：
#   gpt-5.5-r1-staff
#   gpt-5.6-sol-r1-staff
#   gpt-5.6-luna-r1-staff
#   gpt-5.6-terra-r1-staff
# 默认先用 sol；luna / terra 后续逐个改 MODEL 跑通。
MODEL=gpt-5.6-sol-r1-staff

# Claude Code 由 scripts/env.sh 从上面三项推导，不必再填：
#   ANTHROPIC_BASE_URL = OPENAI_BASE_URL 去掉末尾 /v1
#   ANTHROPIC_API_KEY  = OPENAI_API_KEY
#   ANTHROPIC_MODEL 以及 haiku/sonnet/opus 别名 = MODEL
