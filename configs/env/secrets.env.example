# Copy to configs/env/secrets.env. The real file is gitignored.
# One file holds provider credentials/endpoints. Model IDs live in each experiment TOML.
# A target's endpoint_profile=NAME reads NAME_API_KEY and NAME_BASE_URL.
# Do not quote values unless the quote is part of the value.

# --- Anthropic (Claude Code) ---
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
CLAUDE_BIN=
# 不设轮数上限：--max-turns 实测不可靠（同一数值下 30~173 轮都可能完成，也可能在
# 31 轮报 error_max_turns），且 codex/dsh 没有对应开关。硬边界统一用 NATIVE_TIMEOUT_S。
CLAUDE_MAX_BUDGET_USD=5.00

# --- OpenAI (Codex) ---
GPT_API_KEY=
GPT_BASE_URL=https://api.openai.com/v1
CODEX_BIN=

# --- DeepSeek (dsh) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DSH_BIN=

# --- ingest LLM no-think 网关（可选，但推理模型必开）---
# 设了 INGEST_LLM_BASE_URL 后，被测记忆系统（mem0 / amem / zep）的**事实抽取** LLM
# 统一走该网关，而不是直连 targets[].memory_config.internal_model.endpoint_profile。
# 网关负责关 thinking / 剥 <think> / 超时重试，一处实现。
# 为什么必须：推理模型的 reasoning_content 会吃掉补全预算，带 response_format=json_object
# 的抽取结果被截断成非法 JSON → adapter 的 json 守卫 fail-closed → 整个 ingest 中止。
# 长语料必然发生；调大 max_tokens 只能把失败点往后推（实测 2000→第 27 篇，8000→第 114 篇）。
# 启动网关（二选一）：
#   ./venv/bin/python -m services.no_think_proxy --port 9800   # 无 fastapi 依赖，仅 chat 转发
#   ./venv/bin/python -m services.embed_server --port 9800     # 需 fastapi/uvicorn（容器内）
# 上游地址由网关进程自己的 $LLM_UPSTREAM 决定；INGEST_LLM_API_KEY 仅在网关要求鉴权时需要。
INGEST_LLM_BASE_URL=
INGEST_LLM_API_KEY=
INGEST_LLM_MODEL=

# --- shared ---
NATIVE_TIMEOUT_S=240
